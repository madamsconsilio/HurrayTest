#!/usr/bin/env python3\cf4 \
\cf5 """\
Local proxy server for Relativity and Floodgate API.\
Routes:\
  - /proxy/*     -> https://apple-development.relativity.one/*\
  - /floodgate/* -> https://floodgate.g.apple.com/api/anthropic/*\
  - /token       -> runs appleconnect locally and returns a fresh Floodgate OIDC token!\
Usage:\
  python3 proxy.py\
"""\cf4 \
\
\cf6 import\cf4  http.server\
\cf6 import\cf4  json\
\cf6 import\cf4  os\
\cf6 import\cf4  subprocess\
\cf6 import\cf4  urllib.request\
\cf6 import\cf4  urllib.error\
\
RELATIVITY_TARGET = \cf5 "https://apple-development.relativity.one"\cf4 \
FLOODGATE_TARGET  = \cf5 "https://floodgate.g.apple.com/api/anthropic"\cf4 \
PORT = \cf7 8080\cf4 \
\
CLIENT_ID = \cf5 "hvys3fcwcteqrvw3qzkvtk86viuoqv"\cf4 \
SCOPES    = \cf5 "openid,dsid,accountname,profile,groups"\cf4 \
\
\
\cf6 def\cf4  \cf8 get_appleconnect_token\cf4 ():\
    \cf5 """Generates a fresh Floodgate token using appleconnect on macOS."""\cf4 \
    candidates = [\cf5 "/usr/local/bin/appleconnect"\cf4 , \cf5 "/opt/homebrew/bin/appleconnect"\cf4 ]\
    ac_bin = \cf9 next\cf4 ((c \cf6 for\cf4  c \cf6 in\cf4  candidates \cf6 if\cf4  os.path.isfile(c)), \cf5 "appleconnect"\cf4 )\
    \
    cmd = [\
        ac_bin, \cf5 "getToken"\cf4 ,\
        \cf5 "-C"\cf4 , CLIENT_ID,\
        \cf5 "--token-type=oauth"\cf4 ,\
        \cf5 "--interactivity-type=gui"\cf4 ,\
        \cf5 "-E"\cf4 , \cf5 "prod"\cf4 ,\
        \cf5 "-G"\cf4 , \cf5 "pkce"\cf4 ,\
        \cf5 "-o"\cf4 , SCOPES\
    ]\
    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=\cf7 True\cf4 )\
    \cf6 if\cf4  res.returncode != \cf7 0\cf4 :\
        \cf6 raise\cf4  RuntimeError(\cf5 f"appleconnect failed (\cf10 \{res.returncode\}\cf5 ): \cf10 \{res.stderr.strip() \cf6 or\cf10  res.stdout.strip()\}\cf5 "\cf4 )\
    \
    \cf2 # Parse id-token line\cf4 \
    \cf6 for\cf4  line \cf6 in\cf4  res.stdout.splitlines():\
        \cf6 if\cf4  line.startswith(\cf5 "oauth-id-token:"\cf4 ) \cf6 or\cf4  line.startswith(\cf5 "id-token:"\cf4 ):\
            \cf6 return\cf4  line.split(\cf5 ":"\cf4 , \cf7 1\cf4 )[\cf7 1\cf4 ].strip()\
            \
    \cf6 raise\cf4  RuntimeError(\cf5 f"Could not find oauth-id-token in appleconnect output."\cf4 )\
\
\
\cf6 class\cf4  \cf8 ProxyHandler\cf4 (http.server.BaseHTTPRequestHandler):\
\
    \cf6 def\cf4  \cf8 log_message\cf4 (self, \cf9 format\cf4 , *args):\
        \cf9 print\cf4 (\cf5 f"  \cf10 \{self.command\}\cf5  \cf10 \{self.path\}\cf5  \uc0\u8594  \cf10 \{args[\cf7 1\cf10 ] \cf6 if\cf10  \cf9 len\cf10 (args) > \cf7 1\cf10  \cf6 else\cf10  \cf5 ''\cf10 \}\cf5 "\cf4 )\
\
    \cf6 def\cf4  \cf8 do_OPTIONS\cf4 (self):\
        \cf2 # Handle CORS preflight cleanly for Safari\cf4 \
        self.send_response(\cf7 200\cf4 )\
        self.send_header(\cf5 "Access-Control-Allow-Origin"\cf4 , \cf5 "*"\cf4 )\
        self.send_header(\cf5 "Access-Control-Allow-Methods"\cf4 , \cf5 "GET, POST, OPTIONS"\cf4 )\
        self.send_header(\cf5 "Access-Control-Allow-Headers"\cf4 , \cf5 "Content-Type, Authorization, x-api-key"\cf4 )\
        self.end_headers()\
\
    \cf6 def\cf4  \cf8 do_GET\cf4 (self):\
        \cf6 if\cf4  self.path == \cf5 "/token"\cf4 :\
            self._handle_token_request()\
        \cf6 elif\cf4  self.path.startswith(\cf5 "/proxy/"\cf4 ):\
            self._proxy(RELATIVITY_TARGET, self.path[\cf9 len\cf4 (\cf5 "/proxy"\cf4 ) - \cf7 1\cf4 :])\
        \cf6 else\cf4 :\
            self.send_error(\cf7 404\cf4 , \cf5 "Not Found"\cf4 )\
\
    \cf6 def\cf4  \cf8 do_POST\cf4 (self):\
        \cf6 if\cf4  self.path.startswith(\cf5 "/floodgate/"\cf4 ):\
            \cf2 # Maps /floodgate/v1/messages -> https://floodgate.g.apple.com/api/anthropic/v1/messages\cf4 \
            remote_path = self.path[\cf9 len\cf4 (\cf5 "/floodgate"\cf4 ):]\
            self._proxy(FLOODGATE_TARGET, remote_path)\
        \cf6 elif\cf4  self.path.startswith(\cf5 "/proxy/"\cf4 ):\
            self._proxy(RELATIVITY_TARGET, self.path[\cf9 len\cf4 (\cf5 "/proxy"\cf4 ) - \cf7 1\cf4 :])\
        \cf6 else\cf4 :\
            self.send_error(\cf7 404\cf4 , \cf5 "Not Found"\cf4 )\
\
    \cf6 def\cf4  \cf8 _handle_token_request\cf4 (self):\
        \cf6 try\cf4 :\
            token = get_appleconnect_token()\
            body = json.dumps(\{\cf5 "token"\cf4 : token\}).encode(\cf5 "utf-8"\cf4 )\
            self.send_response(\cf7 200\cf4 )\
            self.send_header(\cf5 "Content-Type"\cf4 , \cf5 "application/json"\cf4 )\
            self.send_header(\cf5 "Access-Control-Allow-Origin"\cf4 , \cf5 "*"\cf4 )\
            self.end_headers()\
            self.wfile.write(body)\
        \cf6 except\cf4  Exception \cf6 as\cf4  e:\
            err_body = json.dumps(\{\cf5 "error"\cf4 : \cf9 str\cf4 (e)\}).encode(\cf5 "utf-8"\cf4 )\
            self.send_response(\cf7 500\cf4 )\
            self.send_header(\cf5 "Content-Type"\cf4 , \cf5 "application/json"\cf4 )\
            self.send_header(\cf5 "Access-Control-Allow-Origin"\cf4 , \cf5 "*"\cf4 )\
            self.end_headers()\
            self.wfile.write(err_body)\
\
    \cf6 def\cf4  \cf8 _proxy\cf4 (self, target_base, remote_path):\
        url = target_base + remote_path\
        content_length = \cf9 int\cf4 (self.headers.get(\cf5 "Content-Length"\cf4 , \cf7 0\cf4 ))\
        body = self.rfile.read(content_length) \cf6 if\cf4  content_length > \cf7 0\cf4  \cf6 else\cf4  \cf7 None\cf4 \
\
        skip = \{\cf5 "host"\cf4 , \cf5 "connection"\cf4 , \cf5 "transfer-encoding"\cf4 , \cf5 "content-length"\cf4 \}\
        headers = \{k: v \cf6 for\cf4  k, v \cf6 in\cf4  self.headers.items() \cf6 if\cf4  k.lower() \cf6 not\cf4  \cf6 in\cf4  skip\}\
\
        \cf6 try\cf4 :\
            req = urllib.request.Request(url, data=body, headers=headers, method=self.command)\
            \cf6 with\cf4  urllib.request.urlopen(req) \cf6 as\cf4  resp:\
                resp_body = resp.read()\
                self.send_response(resp.status)\
                \cf6 for\cf4  key, value \cf6 in\cf4  resp.getheaders():\
                    \cf6 if\cf4  key.lower() \cf6 in\cf4  (\cf5 "transfer-encoding"\cf4 , \cf5 "connection"\cf4 ):\
                        \cf6 continue\cf4 \
                    self.send_header(key, value)\
                self.send_header(\cf5 "Access-Control-Allow-Origin"\cf4 , \cf5 "*"\cf4 )\
                self.end_headers()\
                self.wfile.write(resp_body)\
        \cf6 except\cf4  urllib.error.HTTPError \cf6 as\cf4  e:\
            resp_body = e.read()\
            self.send_response(e.code)\
            self.send_header(\cf5 "Content-Type"\cf4 , \cf5 "application/json"\cf4 )\
            self.send_header(\cf5 "Access-Control-Allow-Origin"\cf4 , \cf5 "*"\cf4 )\
            self.end_headers()\
            self.wfile.write(resp_body)\
        \cf6 except\cf4  Exception \cf6 as\cf4  e:\
            err_msg = json.dumps(\{\cf5 "error"\cf4 : \cf9 str\cf4 (e)\}).encode(\cf5 "utf-8"\cf4 )\
            self.send_response(\cf7 502\cf4 )\
            self.send_header(\cf5 "Content-Type"\cf4 , \cf5 "application/json"\cf4 )\
            self.send_header(\cf5 "Access-Control-Allow-Origin"\cf4 , \cf5 "*"\cf4 )\
            self.end_headers()\
            self.wfile.write(err_msg)\
\
\
\cf6 if\cf4  __name__ == \cf5 "__main__"\cf4 :\
    server = http.server.HTTPServer((\cf5 "127.0.0.1"\cf4 , PORT), ProxyHandler)\
    \cf9 print\cf4 (\cf5 f"\uc0\u10003  Proxy running at http://localhost:\cf10 \{PORT\}\cf5 "\cf4 )\
    \cf9 print\cf4 (\cf5 f"  \'95 /floodgate/* -> \cf10 \{FLOODGATE_TARGET\}\cf5 /*"\cf4 )\
    \cf9 print\cf4 (\cf5 f"  \'95 /token       -> auto-generates AppleConnect token"\cf4 )\
