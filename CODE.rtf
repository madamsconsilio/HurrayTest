    \cf9 print\cf4 (\cf5 f"  Press Ctrl+C to stop\\n"\cf4 )\
    \cf6 try\cf4 :\
        server.serve_forever()\
    \cf6 except\cf4  KeyboardInterrupt:\
        \cf9 print\cf4 (\cf5 "\\nStopped."\cf4 )\
