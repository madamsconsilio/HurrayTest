                    sessionStorage.\cf8 setItem\cf4 (\cf5 "FloodgateIdToken"\cf4 , data.token);\
                    status.innerHTML = \cf5 "<span style='color:green;'>\uc0\u10003  Token acquired via appleconnect!</span>"\cf4 ;\
                \} \cf6 else\cf4  \{\
