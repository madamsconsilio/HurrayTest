                .\cf8 replace\cf4 (\cf5 /&/g\cf4 , \cf5 "&amp;"\cf4 )\
                .\cf8 replace\cf4 (\cf5 /</g\cf4 , \cf5 "&lt;"\cf4 )\
                .\cf8 replace\cf4 (\cf5 />/g\cf4 , \cf5 "&gt;"\cf4 )\
                .\cf8 replace\cf4 (\cf5 /"/g\cf4 , \cf5 "&quot;"\cf4 )\
                .\cf8 replace\cf4 (\cf5 /'/g\cf4 , \cf5 "&#039;"\cf4 );\
        \}\
    </\cf13 script\cf4 >\
</\cf13 body\cf4 >\
