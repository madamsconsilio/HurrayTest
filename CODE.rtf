\
            \cf6 try\cf4  \{\
                \cf6 const\cf4  response = \cf6 await\cf4  \cf8 fetch\cf4 (\cf7 FLOODGATE_PROXY_ENDPOINT\cf4 , \{\
                    \cf7 method\cf4 : \cf5 "POST"\cf4 ,\
