        \cf6 const\cf4  \cf7 DEFAULT_MODEL\cf4  = \cf5 "anthropic.claude-sonnet-4-6"\cf4 ;\
\
        \cf6 window\cf4 .\cf8 addEventListener\cf4 (\cf5 "DOMContentLoaded"\cf4 , () => \{\
            \cf6 const\cf4  saved = sessionStorage.\cf8 getItem\cf4 (\cf5 "FloodgateIdToken"\cf4 );\
