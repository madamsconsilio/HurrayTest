            \}\
        \}\
\
        \cf6 function\cf4  \cf8 toggleTokenVisibility\cf4 () \{\
            \cf6 const\cf4  input = \cf6 document\cf4 .\cf8 getElementById\cf4 (\cf5 "txtClientToken"\cf4 );\
            input.type = input.type === \cf5 "password"\cf4  ? \cf5 "text"\cf4  : \cf5 "password"\cf4 ;\
        \}\
\
        \cf6 async\cf4  \cf6 function\cf4  \cf8 testFloodgateViaProxy\cf4 () \{\
            \cf6 const\cf4  respBox = \cf6 document\cf4 .\cf8 getElementById\cf4 (\cf5 "floodgateDirectResponse"\cf4 );\
            respBox.style.display = \cf5 "block"\cf4 ;\
            respBox.style.color = \cf5 "#333"\cf4 ;\
            respBox.innerHTML = \cf5 "Sending request through local proxy.py..."\cf4 ;\
\
            \cf6 const\cf4  token = \cf6 document\cf4 .\cf8 getElementById\cf4 (\cf5 "txtClientToken"\cf4 ).value.\cf8 trim\cf4 () || sessionStorage.\cf8 getItem\cf4 (\cf5 "FloodgateIdToken"\cf4 );\
\
            \cf6 if\cf4  (!token) \{\
                respBox.style.color = \cf5 "red"\cf4 ;\
