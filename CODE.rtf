                \cf6 document\cf4 .\cf8 getElementById\cf4 (\cf5 "txtClientToken"\cf4 ).value = saved;\
                \cf6 document\cf4 .\cf8 getElementById\cf4 (\cf5 "clientTokenStatus"\cf4 ).innerHTML = \cf5 "<span style='color:green;'>\uc0\u10003  Token active in session</span>"\cf4 ;\
            \}\
        \});\
\
        \cf6 async\cf4  \cf6 function\cf4  \cf8 fetchTokenFromProxy\cf4 () \{\
            \cf6 const\cf4  status = \cf6 document\cf4 .\cf8 getElementById\cf4 (\cf5 "clientTokenStatus"\cf4 );\
